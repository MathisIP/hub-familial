{
  "name": "nestync",
  "version": "0.1.0",
  "private": true,
  "description": "Nestync — application PWA d'organisation familiale, multi-foyer (Postgres/Neon)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "comptes": "node scripts/comptes-sync.mjs",
    "beta": "node scripts/beta.mjs",
    "avis:apercu": "node --import tsx scripts/avis-reconduction.mts",
    "captures": "node scripts/captures.mjs",
    "verif:avis": "node --import tsx scripts/verif-avis-reconduction.mts",
    "verif:reclamations": "node --import tsx scripts/verif-reclamations.mts",
    "verif:isolation": "node scripts/verif-isolation.mjs",
    "bac:init": "node scripts/bac-init.mjs",
    "bac:garnir": "node scripts/demo-seed.mjs",
    "bac:reset": "npm run db:migrate && npm run bac:garnir",
    "db:migrate:prod": "node scripts/migrer-prod.mjs",
    "verif:date": "node --import tsx scripts/verif-date-saisie.mts",
    "verif:agenda": "node --import tsx scripts/verif-agenda-dates.mts",
    "verif:astuce": "node --import tsx scripts/verif-astuce.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "archiver": "^8.0.0",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^173.0.0",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^22.3.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.4",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "es5-ext@0.10.64": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true,
    "@ampproject/toolbox-optimizer@2.6.0": true
  }
}
